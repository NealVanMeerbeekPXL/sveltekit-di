generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("SECRET_DATABASE_URL")
}

// TODO add schema here
model Dma {
    id String @db.Uuid @id @default(uuid()) 
    company String
    name String
}